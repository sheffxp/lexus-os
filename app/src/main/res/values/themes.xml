<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Используем стандартный платформенный стиль NoActionBar без внешних библиотек -->
    <style name="Theme.Design.NoActionBar" parent="android:Theme.DeviceDefault.NoActionBar.Fullscreen">
        <!-- Дополнительные параметры для надежности -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>